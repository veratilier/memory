{
  "name": "vera-memory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --port 8791",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:connection": "node scripts/verify-connection.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply memory-db --local",
    "db:remote": "wrangler d1 migrations apply memory-db --remote",
    "test:acceptance": "node scripts/local-acceptance.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  }
}
